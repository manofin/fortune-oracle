[Unit]
Description=Fortune Oracle mobile web
After=network-online.target

[Service]
Type=simple
# Replace @RUNTIME@ and @NODE_DIR@ when installing this user unit.
WorkingDirectory=@RUNTIME@/current/web
EnvironmentFile=@RUNTIME@/runtime.env
Environment=PATH=@RUNTIME@/venv/bin:@NODE_DIR@:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@RUNTIME@/venv/bin/gunicorn --bind 127.0.0.1:8766 --workers 1 --threads 6 --timeout 45 --error-logfile - wsgi:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@RUNTIME@/data

[Install]
WantedBy=default.target
